{
  "schemaVersion": 1,
  "id": "hammer",
  "version": "${version}",
  "name": "Hammer",
  "description": "A configurable mining and throwing hammer.",
  "authors": [
    "j40climb"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.j40climb.florafauna_hammer.FabricHammer"
    ],
    "client": [
      "net.j40climb.florafauna_hammer.setup.ClientSetup"
    ]
  },
  "mixins": [
    "hammer.mixins.json",
    "hammer.fabric.mixins.json",
    {
      "config": "hammer.fabric.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "hammer.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=25"
  },
  "breaks": {
    "florafauna": "<0.0.2"
  }
}
